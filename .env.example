# ApexMind — local secrets. Copy this file to `.env` and fill in the values.
# `.env` is gitignored; never commit your real tokens.

# --- Telegram notifications ---------------------------------------------- #
# 1. In Telegram, message @BotFather -> /newbot -> copy the token it gives you.
# 2. Message your new bot once (say "hi"), then visit:
#       https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    and read the numeric "chat":{"id": ...} value. That is your chat id.
#    (For a group, add the bot to the group and use the negative group id.)
# Once both are set, the daily prepare run (apex_daily.py / the "ApexMind Daily Prepare"
# task) ALWAYS sends a "📡 Briefing ready — N Politics/Geopolitics markets" ping after
# each scan, PLUS a short Decision-Memo summary whenever new POSITIONs were recorded
# since the last run. End-of-cycle memos (main_agent.py notify) are delivered here too.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to false to globally silence Telegram sends without removing the token.
APEX_NOTIFY_ENABLED=true

# --- Reasoning agent ----------------------------------------------------- #
# Keep `claude` for the existing Claude Code workflow, or use `codex` to run the
# exact same ApexMind cycle with Codex. No model API key is required when the
# selected CLI is signed in with its subscription account.
APEX_AGENT_PROVIDER=claude
# Optional CLI overrides. The defaults are claude.cmd/codex.cmd on Windows and
# claude/codex elsewhere.
# APEX_CLAUDE_CLI=claude.cmd
# APEX_CODEX_CLI=codex.cmd

# --- Research backends (all optional; keyless DuckDuckGo used if unset) --- #
# Web search: Brave is preferred, then SerpAPI, then keyless DuckDuckGo scraping.
#   Brave free tier:  https://brave.com/search/api/
#   SerpAPI:          https://serpapi.com/
BRAVE_API_KEY=
SERPAPI_KEY=
# X/Twitter: X API bearer (paid) is preferred, otherwise a degraded site:x.com web
# fallback. (The old Nitter backend was removed — most public instances are defunct.)
X_BEARER_TOKEN=
# Per-market research snippets inside the briefing (ON by default; set false to skip).
APEX_INCLUDE_RESEARCH=true

# On-chain + polling research are keyless by default. Optional keys raise rate
# limits / unlock holder data:
COINGECKO_API_KEY=
ETHERSCAN_API_KEY=

# --- Schema sentinel (upstream API drift monitor; pure monitoring) -------- #
# When true, ApexMind validates that Polymarket's Gamma /markets and CLOB
# /prices-history responses still carry the critical fields the pipeline parses, and
# sends ONE throttled Telegram alert per endpoint per interval if a field is
# renamed/removed. It NEVER raises or changes analysis — monitoring only. OFF by
# default; needs TELEGRAM_* set above to actually deliver the alert.
APEX_SCHEMA_SENTINEL_ENABLED=false
# Seconds between repeat alerts for the same endpoint (default 86400 = once per day).
APEX_SCHEMA_SENTINEL_INTERVAL=86400

# --- Optional overrides (any config.py value works here) ----------------- #
# APEX_MIN_EDGE=0.08
# APEX_MIN_CONFIDENCE=0.55
# APEX_MIN_BUCKET_N=8               # calibration: min resolved markets for a bucket to be "reliable"
# APEX_SHORTLIST_SIZE=15
# APEX_RESEARCH_TTL=21600           # research cache lifetime in seconds
